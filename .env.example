# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL instance works (Neon, Vercel Postgres, Supabase, self-hosted).
# Use the POOLED connection string on Neon/Vercel — serverless functions open
# many short-lived connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# X (Twitter) source
# ---------------------------------------------------------------------------
# DEPRECATED — sources now live in the database and are managed from Telegram:
#   /addsource @username
#
# These two are kept only for backward compatibility: on the first run with an
# empty source list they are imported once, after which they are ignored.
# A new installation should leave them blank and use /addsource instead.
X_USER_ID=
X_USERNAME=

# App-only Bearer token from the X Developer Portal (Keys and tokens tab).
X_BEARER_TOKEN=

# Override only if you proxy the API. Default: https://api.x.com
X_API_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram destination
# ---------------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric channel id (preferred, works for private channels) e.g. -1001234567890
# or a public @channelusername.
TELEGRAM_CHAT_ID=

# Override only if you run a local Bot API server. Default: https://api.telegram.org
TELEGRAM_API_BASE_URL=

# Post silently (no notification sound) when true.
TELEGRAM_DISABLE_NOTIFICATION=false

# ---------------------------------------------------------------------------
# Review before publishing (optional)
# ---------------------------------------------------------------------------
# With REQUIRE_APPROVAL=true a post is first delivered to your private chat with
# the bot, carrying Approve / Reject buttons, and only reaches the channel when
# you press Approve.
#
# Requires all three, plus one-off webhook registration:
#   npm run webhook:set -- https://your-project.vercel.app
REQUIRE_APPROVAL=false

# Your numeric Telegram user id (not the channel id). Send /start to the bot
# first — Telegram forbids a bot from messaging a user who never started it.
TELEGRAM_ADMIN_CHAT_ID=

# Proves a webhook call really came from Telegram. Generate with:
#   openssl rand -hex 32
# Only A-Z a-z 0-9 _ - are allowed, so base64 will NOT work.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS origin of this deployment, e.g. https://your-project.vercel.app
# Enables the "Edit text" button, which opens a Mini App for rewriting a
# caption before approval. Use the stable production domain, not a
# per-deployment URL: the button is built when a post is queued and may be
# pressed days later. Leave blank and review works without the button.
APP_BASE_URL=

# Shadow Radar (optional). Scores how likely you are to publish each post —
# recorded only, never shown to the reviewer — for tenants whose workspace has
# an editorial_profile, and only when the chosen provider's key is set.
# RADAR_PROVIDER: openai (GPT-6 Luna, the default) or anthropic (Claude Haiku 4.5).
# RADAR_MODEL overrides that provider's model id.
RADAR_PROVIDER=openai
RADAR_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Minimum 16 characters. Vercel sends this automatically as a Bearer token
# when it invokes the cron job.
CRON_SECRET=

# Optional separate secret for GET /api/status. Falls back to CRON_SECRET.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Message formatting
# ---------------------------------------------------------------------------
CAPTION_PREFIX=
CAPTION_SUFFIX=
INCLUDE_SOURCE_LINK=true

# ---------------------------------------------------------------------------
# Filtering
# ---------------------------------------------------------------------------
INCLUDE_REPLIES=false
INCLUDE_REPOSTS=false
INCLUDE_QUOTES=true

# ---------------------------------------------------------------------------
# Throughput and reliability
# ---------------------------------------------------------------------------
# Posts published per run. Keep modest to stay inside Telegram's rate limits.
MAX_POSTS_PER_RUN=5

# Posts requested from X per run (API accepts 5-100). Must be >= MAX_POSTS_PER_RUN.
X_FETCH_LIMIT=20

# Attempts per transient failure, including the first.
MAX_RETRY_ATTEMPTS=5

# multipart = download then upload bytes (default; 10 MB photo / 50 MB video)
# url       = hand Telegram the CDN link (5 MB photo / 20 MB other)
MEDIA_UPLOAD_MODE=multipart

# Hard ceiling for video, in MB (1-50). Nothing larger is ever sent.
MAX_VIDEO_SIZE_MB=50

# Preferred video size, in MB (1-50). X publishes each video at several
# bitrates: if one is at or under this, it is sent; if none is, the original is
# sent anyway (up to MAX_VIDEO_SIZE_MB) rather than dropping the post.
# Leave empty for "always the best quality that fits".
PREFERRED_VIDEO_SIZE_MB=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# true = do everything except actually publish. Start here, then set to false.
DRY_RUN=true
