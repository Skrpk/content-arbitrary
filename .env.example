# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL instance works (Neon, Vercel Postgres, Supabase, self-hosted).
# Use the POOLED connection string on Neon/Vercel — serverless functions open
# many short-lived connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# X (Twitter) source
# ---------------------------------------------------------------------------
# Set X_USER_ID if you know it: it saves one billed API call on every run.
# If only X_USERNAME is set, the app resolves the id once per run.
X_USER_ID=
X_USERNAME=

# App-only Bearer token from the X Developer Portal (Keys and tokens tab).
X_BEARER_TOKEN=

# Override only if you proxy the API. Default: https://api.x.com
X_API_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram destination
# ---------------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric channel id (preferred, works for private channels) e.g. -1001234567890
# or a public @channelusername.
TELEGRAM_CHAT_ID=

# Override only if you run a local Bot API server. Default: https://api.telegram.org
TELEGRAM_API_BASE_URL=

# Post silently (no notification sound) when true.
TELEGRAM_DISABLE_NOTIFICATION=false

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Minimum 16 characters. Vercel sends this automatically as a Bearer token
# when it invokes the cron job.
CRON_SECRET=

# Optional separate secret for GET /api/status. Falls back to CRON_SECRET.
ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Message formatting
# ---------------------------------------------------------------------------
CAPTION_PREFIX=
CAPTION_SUFFIX=
INCLUDE_SOURCE_LINK=true

# ---------------------------------------------------------------------------
# Filtering
# ---------------------------------------------------------------------------
INCLUDE_REPLIES=false
INCLUDE_REPOSTS=false
INCLUDE_QUOTES=true

# ---------------------------------------------------------------------------
# Throughput and reliability
# ---------------------------------------------------------------------------
# Posts published per run. Keep modest to stay inside Telegram's rate limits.
MAX_POSTS_PER_RUN=5

# Posts requested from X per run (API accepts 5-100). Must be >= MAX_POSTS_PER_RUN.
X_FETCH_LIMIT=20

# Attempts per transient failure, including the first.
MAX_RETRY_ATTEMPTS=5

# multipart = download then upload bytes (default; 10 MB photo / 50 MB video)
# url       = hand Telegram the CDN link (5 MB photo / 20 MB other)
MEDIA_UPLOAD_MODE=multipart

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# true = do everything except actually publish. Start here, then set to false.
DRY_RUN=true
